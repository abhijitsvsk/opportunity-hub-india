# Supabase (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Gemini AI (Fallback LLM Structurer - Free tier)
GEMINI_API_KEY=your_gemini_key

# Groq AI (Primary LLM Structurer - Free on-demand)
GROQ_API_KEY=your_groq_key

# Discord Bot Gateway (Optional: Community Opportunity Scraping)
DISCORD_BOT_TOKEN=your_bot_token
DISCORD_CHANNEL_IDS=channel_id_1,channel_id_2

# Discord Webhook (Optional: Pipeline Alerts & Digests)
# Generate via: Channel Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Kaggle API (Optional: ML Competitions Scraper - Free)
# Generate via: Kaggle.com > Account > API > Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
