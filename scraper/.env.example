# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# Gemini AI (for Structurer)
GEMINI_API_KEY=your_gemini_key

# Discord Webhook (for Pipeline Alerts)
